# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL="postgres://shelfwatch:shelfwatch@localhost:5432/shelfwatch"

# Port the API listens on. Railway and Render inject their own — never hardcode.
PORT=3001

NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
CORS_ORIGIN="http://localhost:5173"
