# Leave unset in development — vite.config.ts proxies /api to localhost:3001,
# which keeps the browser same-origin.
#
# Set this at BUILD time in production to the deployed API's origin. Vite
# inlines import.meta.env at build time, so changing it later needs a rebuild,
# not a restart.
# VITE_API_URL="https://shelf-api.up.railway.app"
